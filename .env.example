# PatchPilot Environment Configuration
# Copy this file to .env and fill in the actual values.
# NEVER commit .env to source control.

# ─── Nebius / NVIDIA Inference ────────────────────────────────────────────────
# Nebius Token Factory endpoint (OpenAI-compatible)
NEBIUS_API_BASE_URL=https://api.studio.nebius.ai/v1
# Your Nebius API key (server-side only — never expose in browser)
NEBIUS_API_KEY=your_nebius_api_key_here
# NVIDIA open-source model available through Nebius
# nvidia/Llama-3.1-Nemotron-70B-Instruct-HF (Apache 2.0)
NEBIUS_MODEL_ID=nvidia/Llama-3.1-Nemotron-70B-Instruct-HF

# ─── Backend ──────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./patchpilot.db
# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Upload limits
MAX_UPLOAD_SIZE_MB=50
MAX_REPO_FILES=2000
MAX_FILE_SIZE_KB=512

# ─── Sandbox ──────────────────────────────────────────────────────────────────
SANDBOX_ENABLED=true
SANDBOX_TIMEOUT_SECONDS=120
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1.0
SANDBOX_NETWORK=none
SANDBOX_IMAGE=python:3.11-slim

# ─── Agent ────────────────────────────────────────────────────────────────────
AGENT_MAX_REPAIR_ITERATIONS=3
AGENT_MAX_TOOL_CALLS=20
AGENT_MAX_CONTEXT_TOKENS=8000

# ─── Frontend ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
